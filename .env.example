# Required: Neon PostgreSQL pooled connection string (server-only, never expose to client).
DATABASE_URL="postgresql://user:password@host:5432/mehfil?sslmode=require"
# Required for Prisma migrations (Neon direct connection, no pooler).
DIRECT_URL="postgresql://user:password@host:5432/mehfil?sslmode=require"
# Required to run `npm run create-admin` when set. Use a long random value.
ADMIN_SETUP_SECRET="change-me-to-a-long-random-setup-secret"
# Optional: public URL of the deployed app (used for shop QR / links). No secret.
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
